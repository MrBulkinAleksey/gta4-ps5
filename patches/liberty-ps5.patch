+void SharedMemory::RecordPageHashes(uint32_t page_first, uint32_t page_count) {
+  const size_t page_size = size_t(1) << page_size_log2_;
+  for (uint32_t page = page_first; page_count && page < page_hashes_.size(); ++page, --page_count) {
+    const uint64_t hash =
+        XXH3_64bits(memory_.TranslatePhysical((page << page_size_log2_) & (kBufferSize - 1)), page_size);
+    page_hashes_[page] = hash ? hash : 1;
+  }
+}
+
+uint32_t SharedMemory::CheckStalePages(uint32_t pages_per_frame) {
+  const uint32_t page_count = kBufferSize >> page_size_log2_;
+  if (!pages_per_frame || page_hashes_.size() != page_count) {
+    return 0;
+  }
+  const uint32_t page_size = uint32_t(1) << page_size_log2_;
+  uint32_t cursor = stale_check_cursor_ & (page_count - 1);
+  uint32_t remaining = std::min(pages_per_frame, page_count);
+  uint32_t found = 0;
+  while (remaining) {
+    // (one 64-page block of flags at a time)
+    const uint32_t chunk = std::min({(cursor & ~uint32_t(63)) + 64 - cursor, page_count - cursor, remaining});
+    const uint32_t block = cursor >> 6;
+    uint64_t candidates = 0;
+    {
+      auto global_lock = global_critical_region_.Acquire();
+      const uint64_t* valid_flags = active_valid_flags_.load(std::memory_order_relaxed);
+      if (valid_flags) {
+        candidates = valid_flags[block] & ~system_page_flags_valid_and_gpu_written_[block];
+      }
+    }
+    for (uint32_t page = cursor; page < cursor + chunk; ++page) {
+      const uint64_t stored = page_hashes_[page];
+      const uint64_t bit = uint64_t(1) << (page & 63);
+      if (!stored || !(candidates & bit)) {
+        continue;
+      }
+      const uint32_t address = page << page_size_log2_;
+      {
+        // (under the lock: a page still valid is still committed - freeing
+        // guest memory invalidates it in the same lock)
+        auto global_lock = global_critical_region_.Acquire();
+        const uint64_t* valid_flags = active_valid_flags_.load(std::memory_order_relaxed);
+        if (!valid_flags || !(valid_flags[block] & bit) ||
+            (system_page_flags_valid_and_gpu_written_[block] & bit)) {
+          continue;  // (a watch fired meanwhile)
+        }
+        // (a page the guest made unreadable keeps its GPU copy: reading it
+        // would fault)
+        uint32_t protect = 0;
+        auto* physical_heap = memory_.GetPhysicalHeap();
+        if (!physical_heap || !physical_heap->QueryProtect(address, &protect) ||
+            !(protect & memory::kMemoryProtectRead)) {
+          continue;
+        }
+        if (XXH3_64bits(memory_.TranslatePhysical(address), page_size) == stored) {
+          continue;
+        }
+      }
+      page_hashes_[page] = 0;
+      ++found;
+      ++stale_pages_found_;
+      if (stale_pages_found_ <= 64 || !(stale_pages_found_ & (stale_pages_found_ - 1))) {
+        REXGPU_WARN("GPU copy of physical {:08X} +{:X} out of date, no write watch fired ({} so far)", address,
+                    page_size, stale_pages_found_);
+      }
+      // (each physical view keeps its own watches)
+      memory_.TriggerPhysicalMemoryCallbacks(rex::thread::global_critical_region::AcquireDirect(),
+                                             0xA0000000u + address, page_size, true, true);
+      memory_.TriggerPhysicalMemoryCallbacks(rex::thread::global_critical_region::AcquireDirect(),
+                                             0xC0000000u + address, page_size, true, true);
+      if (address >= 0x1000) {
+        memory_.TriggerPhysicalMemoryCallbacks(rex::thread::global_critical_region::AcquireDirect(),
+                                               0xE0000000u + address - 0x1000, page_size, true, true);
+      }
+      MemoryInvalidationCallback(address, page_size, true);
+    }
+    cursor = (cursor + chunk) & (page_count - 1);
+    remaining -= chunk;
+  }
+  stale_check_cursor_ = cursor;
+  return found;
+}
