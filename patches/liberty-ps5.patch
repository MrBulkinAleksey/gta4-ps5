+++ b/glue/rexglue-sdk-main/gta4-recomp/src/ps5/game/ps5_overlay.h
@@ -0,0 +1,40 @@
+// GTA IV PS5 - what the PS5 build draws over the game: the frame rate counter
+// (always on, top left: frames a second and the frame time), the beta build's
+// watermark along the bottom, and, when it's on in the hub's Debug settings,
+// a frame time capture to /app0/logs.
+#pragma once
+
+#include <cstdio>
+#include <cstdint>
+
+#include <rex/ui/imgui_dialog.h>
+
+namespace gta4ps5 {
+
+class GameOverlay final : public rex::ui::ImGuiDialog {
+ public:
+  explicit GameOverlay(rex::ui::ImGuiDrawer* drawer);
+  ~GameOverlay() override;
+
+ protected:
+  void OnDraw(ImGuiIO& io) override;
+
+ private:
+  void Sample();
+  void Capture();
+
+  // the counter: averaged over half a second
+  uint64_t window_frames_ = 0;
+  int64_t window_start_ns_ = 0;
+  float fps_ = 0, ms_ = 0;
+  // the capture
+  std::FILE* csv_ = nullptr;
+  uint64_t captured_ = 0;
+  int64_t capture_start_ns_ = 0;
+};
+
+// The build's version and the watermark's text.
+const char* BuildVersion();
+const char* Watermark();
+
+}  // namespace gta4ps5
