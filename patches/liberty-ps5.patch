+// GTA IV PS5 - the hub's check of the game's files and its installer (see
+// hub_install.h). The install itself is LibertyRecomp's (install/).
+#include "hub_install.h"
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <thread>
+
+#include <rex/logging.h>
+
+#include "../../install/gta4_install_io.h"
+#include "../../install/gta4_installer.h"
+#include "../../install/gta4_source_inspector.h"
+
+namespace gta4ps5::hub::install {
+
+namespace {
+
+std::string Lower(std::string s) {
+  std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  return s;
+}
+
+// An Xbox 360 content package (a title update, an episode): CON / LIVE / PIRS.
+bool IsPackage(const fs::path& file) {
+  char magic[4] = {};
+  std::ifstream in(file, std::ios::binary);
+  if (!in.read(magic, 4)) return false;
+  return !std::memcmp(magic, "CON ", 4) || !std::memcmp(magic, "LIVE", 4) || !std::memcmp(magic, "PIRS", 4);
+}
+
+uint64_t FolderSize(const fs::path& dir) {
+  uint64_t total = 0;
+  std::error_code ec;
+  for (fs::recursive_directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+    if (it->is_regular_file(ec)) total += it->file_size(ec);
+  return total;
+}
+
+}  // namespace
+
+std::vector<fs::directory_entry> ListDir(const fs::path& dir) {
+  std::vector<fs::directory_entry> out;
+  std::error_code ec;
+  for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) out.push_back(*it);
+  return out;
+}
+
+std::string Bytes(uint64_t n) {
+  char buf[32];
+  if (n >= (1ull << 30)) std::snprintf(buf, sizeof(buf), "%.1f GB", double(n) / double(1ull << 30));
+  else if (n >= (1ull << 20)) std::snprintf(buf, sizeof(buf), "%.0f MB", double(n) / double(1ull << 20));
+  else std::snprintf(buf, sizeof(buf), "%.0f KB", double(n) / 1024.0);
+  return buf;
+}
+
+fs::path InstallFolder(const fs::path& app) { return app / "install"; }
+fs::path GameRoot(const fs::path& app) { return app / "UserData" / "LibertyRecomp" / "game"; }
+
+State Look(const fs::path& app) {
+  State s;
+  s.installed = gta4::install::IsInstallReady(GameRoot(app), &s.reason);
+  const Sources found = Find(app);
+  s.iso = !found.disc.empty();
+  s.update = !found.update.empty();
+  REXLOG_INFO("PS5 hub: installed {}, disc image {}, title update {}{}", s.installed, s.iso, s.update,
+              s.installed ? "" : " (" + s.reason + ")");
+  return s;
+}
+
+Sources Find(const fs::path& app) {
+  Sources s;
+  std::error_code ec;
+  auto entries = ListDir(InstallFolder(app));
+  std::sort(entries.begin(), entries.end(),
+            [](const fs::directory_entry& a, const fs::directory_entry& b) { return a.path() < b.path(); });
+  fs::path package;
+  uint64_t package_bytes = 0;
+  for (const auto& e : entries) {
+    const fs::path& p = e.path();
+    const std::string name = Lower(p.filename().string());
+    if (name.empty() || name[0] == '.') continue;
+    if (e.is_directory(ec)) {
+      // an extracted game: a folder with default.xex in it
+      if (s.disc.empty() && fs::is_regular_file(p / "default.xex", ec)) s.disc = p, s.disc_bytes = FolderSize(p);
+      continue;
+    }
+    if (!e.is_regular_file(ec)) continue;
+    const uint64_t size = e.file_size(ec);
+    const std::string ext = Lower(p.extension().string());
+    if (ext == ".iso") {
+      if (s.disc.empty()) s.disc = p, s.disc_bytes = size;
+    } else if (ext == ".xexp" || name.rfind("tu_", 0) == 0) {
+      if (s.update.empty()) s.update = p, s.update_bytes = size;
+    } else if (IsPackage(p) && (package.empty() || size < package_bytes)) {
+      // (a package without the title update's name: the smallest one, as the
+      // episodes are far bigger)
+      package = p, package_bytes = size;
+    }
+  }
+  if (s.update.empty() && !package.empty()) s.update = package, s.update_bytes = package_bytes;
+  return s;
+}
+
+uint64_t FreeSpace(const fs::path& install_root) {
+  std::error_code ec;
+  fs::create_directories(install_root, ec);
+  const auto space = fs::space(install_root, ec);
+  // (on the PS5 a title can't learn the drive's free space: the SDK's
+  // statvfs always answers 16 GiB, so that means "not known")
+  if (ec || uint64_t(space.available) == (16ull << 30)) return 0;
+  return uint64_t(space.available);
+}
+
+// ------------------------------------------------------------------ the job
+
+struct Job::Impl {
+  using Clock = std::chrono::steady_clock;
+
+  fs::path app, root;
+  Sources found;
+  mutable std::mutex m;
+  std::condition_variable cv;
+  Status st;
+  bool go = false, quit = false;
+  gta4::install::Progress progress;
+  Clock::time_point started;
+  std::thread thread;
+  // (Get's bookkeeping)
+  mutable uint64_t copy_total = 0, unpack_guess = 0;
+  mutable float shown = 0;
+  mutable Clock::time_point rate_at{};
+  mutable uint64_t rate_bytes = 0;
+  mutable float rate = 0;
+  mutable Clock::time_point logged_at{};
+
+  void Set(Phase phase, std::string problem = {}) {
+    std::lock_guard lock(m);
+    st.phase = phase;
+    st.problem = std::move(problem);
+  }
+
+  void Run() {
+    REXLOG_INFO("PS5 installer: disc '{}', title update '{}'", found.disc.string(), found.update.string());
+    if (found.disc.empty()) {
+      Set(Phase::kProblem,
+          "There's no disc image in the install folder. Copy your GTA IV disc image (.iso) into "
+          "/data/homebrew/PPSA94004/install/ and press Triangle.");
+      return;
+    }
+    const auto inspected = gta4::install::InspectGameSource(found.disc);
+    if (!inspected.supported()) {
+      Set(Phase::kProblem, "This disc image can't be used: " + inspected.rejection_reason +
+                               "\nIt has to be the USA disc of GTA IV, the original release.");
+      return;
+    }
+    {
+      std::lock_guard lock(m);
+      st.disc = gta4::install::FormatXexRegion(inspected.region) + "  \xC2\xB7  " + inspected.release_label;
+    }
+    if (found.update.empty()) {
+      Set(Phase::kProblem,
+          "Title Update 8 is missing. Copy TU_1A581VI_000000K000000.0000000000205 into the install folder, next "
+          "to the disc image, and press Triangle.");
+      return;
+    }
+    const uint64_t free = FreeSpace(root), needed = SpaceNeeded(found.disc_bytes);
+    if (free && free < needed) {
+      Set(Phase::kProblem, "There isn't enough free space. The install needs about " + Bytes(needed) +
+                               " and the PS5 has " + Bytes(free) + " free.");
+      return;
+    }
+    Set(Phase::kReady);
+    {
+      std::unique_lock lock(m);
+      cv.wait(lock, [this] { return go || quit; });
+      if (quit) return;
+      st.phase = Phase::kInstalling;
+      started = Clock::now();
+    }
+    REXLOG_INFO("PS5 installer: installing into {}", root.string());
+    gta4::install::Selection selection;
+    selection.game_source = found.disc;
+    selection.update_source = found.update;
+    const auto result = gta4::install::Install(selection, root, progress);
+    if (result.success) {
+      REXLOG_INFO("PS5 installer: done in {:.0f} s",
+                  std::chrono::duration<float>(Clock::now() - started).count());
+      Set(Phase::kDone);
+    } else if (progress.cancel_requested.load()) {
+      REXLOG_INFO("PS5 installer: cancelled");
+      Set(Phase::kCancelled);
+    } else {
+      REXLOG_ERROR("PS5 installer: failed: {}", result.error);
+      Set(Phase::kFailed, result.error);
+    }
+  }
+};
+
+Job::Job(const fs::path& app, const fs::path& install_root) : impl_(std::make_unique<Impl>()) {
+  impl_->app = app;
+  impl_->root = install_root;
+  impl_->found = Find(app);
+  impl_->thread = std::thread([impl = impl_.get()] { impl->Run(); });
+}
+
+Job::~Job() {
+  {
+    std::lock_guard lock(impl_->m);
+    impl_->quit = true;
+  }
+  impl_->progress.cancel_requested = true;
+  impl_->cv.notify_all();
+  if (impl_->thread.joinable()) impl_->thread.join();
+}
+
+const Sources& Job::Found() const { return impl_->found; }
+
+void Job::Start() {
+  {
+    std::lock_guard lock(impl_->m);
+    if (impl_->st.phase != Phase::kReady) return;
+    impl_->go = true;
+  }
+  impl_->cv.notify_all();
+}
+
+void Job::Cancel() { impl_->progress.cancel_requested = true; }
+
+Job::Status Job::Get() const {
+  Impl& j = *impl_;
+  Status s;
+  Impl::Clock::time_point started;
+  {
+    std::lock_guard lock(j.m);
+    s = j.st;
+    started = j.started;
+  }
+  if (s.phase == Phase::kDone) s.progress = 1;
+  if (s.phase != Phase::kInstalling) return s;
+  const auto now = Impl::Clock::now();
+  const uint64_t done = j.progress.copied_bytes.load(), total = j.progress.total_bytes.load();
+  s.written = done;
+  s.seconds = std::chrono::duration<float>(now - started).count();
+  // Two steps: the disc image's files are copied (the total known up front),
+  // then the game's archives are unpacked (their total grows as each one is
+  // opened, so it's guessed from the archives' sizes).
+  if (!j.copy_total && total) j.copy_total = total;
+  float f = 0;
+  if (j.copy_total && total > j.copy_total) {
+    if (!j.unpack_guess) {
+      const fs::path staged = j.root / ".install-staging" / "game";
+      std::error_code ec;
+      for (const char* rpf : {"common.rpf", "xbox360.rpf", "audio.rpf"}) j.unpack_guess += fs::file_size(staged / rpf, ec);
+      j.unpack_guess = j.unpack_guess * 23 / 20;
+    }
+    const uint64_t unpack_total = std::max(total - j.copy_total, j.unpack_guess);
+    s.step = 2;
+    f = 0.45f + 0.55f * float(double(done - std::min(done, j.copy_total)) / double(std::max<uint64_t>(unpack_total, 1)));
+  } else {
+    s.step = 1;
+    f = j.copy_total ? 0.45f * float(double(done) / double(j.copy_total)) : 0;
+  }
+  j.shown = std::max(j.shown, std::min(f, 0.995f));
+  s.progress = j.shown;
+  // the speed, over the last second or so
+  if (j.rate_at == Impl::Clock::time_point{}) j.rate_at = now, j.rate_bytes = done;
+  const float dt = std::chrono::duration<float>(now - j.rate_at).count();
+  if (dt >= 1.0f) {
+    const float r = float(double(done - std::min(done, j.rate_bytes)) / dt);
+    j.rate = j.rate > 0 ? j.rate * 0.6f + r * 0.4f : r;
+    j.rate_at = now, j.rate_bytes = done;
+  }
+  s.rate = j.rate;
+  // every 10 s, how it's going in the log (reading vs writing speed)
+  if (now - j.logged_at >= std::chrono::seconds(10)) {
+    j.logged_at = now;
+    const auto& io = gta4::install::io::GetStats();
+    const double rs = double(io.read_ns.load()) / 1e9, ws = double(io.write_ns.load()) / 1e9;
+    REXLOG_INFO("PS5 installer: step {} {:.1f}% {} of {} in {:.0f} s; read {} in {:.1f} s ({:.0f} MB/s), "
+                "wrote {} in {:.1f} s ({:.0f} MB/s)",
+                s.step, s.progress * 100, Bytes(done), Bytes(total), s.seconds, Bytes(io.read_bytes.load()), rs,
+                rs > 0 ? double(io.read_bytes.load()) / rs / double(1 << 20) : 0.0, Bytes(io.write_bytes.load()), ws,
+                ws > 0 ? double(io.write_bytes.load()) / ws / double(1 << 20) : 0.0);
+  }
+  // time left: what's still to write, at the speed of late (so a fast start
+  // from the PS5's cache doesn't promise too much)
+  if (j.copy_total && j.rate > 0 && s.seconds > 10) {
+    const uint64_t unpack = total > j.copy_total ? std::max(total - j.copy_total, j.unpack_guess)
+                                                 : j.copy_total * 23 / 20;
+    const uint64_t expected = j.copy_total + unpack;
+    s.eta = float(double(expected - std::min(expected, done)) / double(j.rate));
+  }
+  return s;
+}
+
+}  // namespace gta4ps5::hub::install
diff --git a/glue/rexglue-sdk-main/gta4-recomp/src/ps5/hub/hub_install.h b/glue/rexglue-sdk-main/gta4-recomp/src/ps5/hub/hub_install.h
