index 0000000..45a81dc
--- /dev/null
+++ b/glue/rexglue-sdk-main/gta4-recomp/src/install/gta4_install_io.h
@@ -0,0 +1,203 @@
+// The installer's file reading and writing: positional reads and big
+// sequential writes straight to the file, with no stream in between.
+//
+// [ps5 port] C++ file streams hand the file 4 KB at a time, and on the PS5
+// each small write is slow: copying the game that way ran at a few MB/s.
+// Here a write goes out in 8 MB pieces and a read is one call. The time spent
+// reading and writing is counted, for the installer's log.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <vector>
+
+#if defined(_WIN32)
+#include <cstdio>
+#else
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace gta4::install::io {
+
+// Bytes and time spent reading and writing (since the start of the app).
+struct Stats {
+  std::atomic<uint64_t> read_bytes{0}, read_ns{0}, write_bytes{0}, write_ns{0};
+};
+inline Stats& GetStats() {
+  static Stats stats;
+  return stats;
+}
+
+namespace detail {
+inline uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+}  // namespace detail
+
+// A file read at any offset.
+class InFile {
+ public:
+  InFile() = default;
+  InFile(const InFile&) = delete;
+  InFile& operator=(const InFile&) = delete;
+  ~InFile() { Close(); }
+
+  bool Open(const std::filesystem::path& path) {
+    Close();
+#if defined(_WIN32)
+    file_ = _wfopen(path.c_str(), L"rb");
+    if (!file_) return false;
+    _fseeki64(file_, 0, SEEK_END);
+    size_ = uint64_t(_ftelli64(file_));
+    return true;
+#else
+    fd_ = ::open(path.c_str(), O_RDONLY);
+    if (fd_ < 0) return false;
+    struct stat st {};
+    if (::fstat(fd_, &st) != 0) {
+      Close();
+      return false;
+    }
+    size_ = uint64_t(st.st_size);
+    return true;
+#endif
+  }
+
+  uint64_t size() const { return size_; }
+
+  // Exactly `length` bytes at `offset` (false short of that).
+  bool ReadAt(uint64_t offset, void* out, size_t length) {
+    const uint64_t start = detail::NowNs();
+    auto* p = static_cast<uint8_t*>(out);
+    size_t left = length;
+#if defined(_WIN32)
+    if (!file_ || _fseeki64(file_, int64_t(offset), SEEK_SET) != 0) return false;
+    left -= std::fread(p, 1, left, file_);
+#else
+    while (left) {
+      const ssize_t n = ::pread(fd_, p, left, off_t(offset));
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) break;
+      p += n, offset += uint64_t(n), left -= size_t(n);
+    }
+#endif
+    GetStats().read_bytes += length - left;
+    GetStats().read_ns += detail::NowNs() - start;
+    return left == 0;
+  }
+
+  void Close() {
+#if defined(_WIN32)
+    if (file_) std::fclose(file_), file_ = nullptr;
+#else
+    if (fd_ >= 0) ::close(fd_), fd_ = -1;
+#endif
+  }
+
+ private:
+#if defined(_WIN32)
+  FILE* file_ = nullptr;
+#else
+  int fd_ = -1;
+#endif
+  uint64_t size_ = 0;
+};
+
+// A new file written from start to end, 8 MB at a time.
+class OutFile {
+ public:
+  static constexpr size_t kChunk = size_t(8) << 20;
+
+  OutFile() = default;
+  OutFile(const OutFile&) = delete;
+  OutFile& operator=(const OutFile&) = delete;
+  ~OutFile() {
+    if (open_) Close();
+  }
+
+  bool Open(const std::filesystem::path& path) {
+#if defined(_WIN32)
+    file_ = _wfopen(path.c_str(), L"wb");
+    open_ = file_ != nullptr;
+#else
+    fd_ = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    open_ = fd_ >= 0;
+#endif
+    ok_ = open_;
+    buffer_.clear();
+    return open_;
+  }
+
+  bool Write(const void* data, size_t length) {
+    if (!ok_) return false;
+    const auto* p = static_cast<const uint8_t*>(data);
+    if (length >= kChunk) {  // (big: straight out, after what's waiting)
+      return Flush() && Out(p, length);
+    }
+    if (buffer_.size() + length > kChunk && !Flush()) return false;
+    buffer_.insert(buffer_.end(), p, p + length);
+    return true;
+  }
+
+  // Writes what's waiting and closes the file; false if any write failed.
+  bool Close() {
+    if (!open_) return ok_;
+    Flush();
+#if defined(_WIN32)
+    if (std::fclose(file_) != 0) ok_ = false;
+    file_ = nullptr;
+#else
+    if (::close(fd_) != 0) ok_ = false;
+    fd_ = -1;
+#endif
+    open_ = false;
+    return ok_;
+  }
+
+ private:
+  bool Flush() {
+    if (buffer_.empty()) return ok_;
+    const bool done = Out(buffer_.data(), buffer_.size());
+    buffer_.clear();
+    return done;
+  }
+
+  bool Out(const uint8_t* p, size_t length) {
+    if (!ok_) return false;
+    const uint64_t start = detail::NowNs();
+    size_t left = length;
+#if defined(_WIN32)
+    left -= std::fwrite(p, 1, left, file_);
+#else
+    while (left) {
+      const ssize_t n = ::write(fd_, p, left);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) break;
+      p += n, left -= size_t(n);
+    }
+#endif
+    GetStats().write_bytes += length - left;
+    GetStats().write_ns += detail::NowNs() - start;
+    if (left) ok_ = false;
+    return ok_;
+  }
+
+#if defined(_WIN32)
+  FILE* file_ = nullptr;
+#else
+  int fd_ = -1;
+#endif
+  bool open_ = false, ok_ = false;
+  std::vector<uint8_t> buffer_;
+};
+
+}  // namespace gta4::install::io
