+++ b/glue/rexglue-sdk-main/gta4-recomp/src/ps5/hub/hub_installer_page.cpp
@@ -0,0 +1,308 @@
+// GTA IV PS5 - the hub's installer (see hub_ui.h, hub_install.h): START GAME
+// opens it while the game isn't installed. It shows what's in install/ and
+// the disc image's check, then installs with a progress bar. All on the
+// controller; the hub's music keeps playing.
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+#include "hub_style.h"
+#include "hub_ui.h"
+
+namespace gta4ps5::hub {
+
+namespace {
+
+using Phase = install::Job::Phase;
+
+enum RowStatus { kRowChecking, kRowOk, kRowBad, kRowNone };
+
+std::string Minutes(float seconds) {
+  const int m = int(std::ceil(seconds / 60.0f));
+  if (m <= 1) return "Under a minute";
+  return std::to_string(m) + " min";
+}
+
+std::string Rate(float bytes_per_second) {
+  char buf[32];
+  std::snprintf(buf, sizeof(buf), "%.0f MB/s", double(bytes_per_second) / double(1 << 20));
+  return buf;
+}
+
+}  // namespace
+
+std::filesystem::path Hub::InstallRoot() const {
+  return paths_.install.empty() ? paths_.app / "UserData" / "LibertyRecomp" : paths_.install;
+}
+
+bool Hub::Busy() const { return installer_ && job_phase_ == Phase::kInstalling; }
+
+void Hub::OpenInstaller() {
+  installer_ = true;
+  job_ = std::make_unique<install::Job>(paths_.app, InstallRoot());
+  job_phase_ = Phase::kChecking;
+  free_space_ = install::FreeSpace(InstallRoot());
+  shown_progress_ = 0;
+  page_in_ = 0;
+  page_dir_ = 1;
+  focus_y_ = -1;
+}
+
+void Hub::CloseInstaller() {
+  installer_ = false;
+  job_.reset();
+  state_ = install::Look(paths_.app);
+  page_in_ = 0;
+  page_dir_ = -1;
+}
+
+// ---------------------------------------------------------------- drawing
+
+void Hub::Spinner(float cx, float cy, float r, ImU32 col) {
+  const float a = time_ * 5.5f;
+  dl_->PathArcTo(P(cx, cy), r * s_, a, a + 4.4f, 32);
+  dl_->PathStroke(col, 0, 3.2f * s_);
+}
+
+void Hub::Tick(float cx, float cy, float size, ImU32 col) {
+  const float k = size / 20;
+  dl_->PathLineTo(P(cx - 9 * k, cy + 0.5f * k));
+  dl_->PathLineTo(P(cx - 3 * k, cy + 6.5f * k));
+  dl_->PathLineTo(P(cx + 9.5f * k, cy - 6.5f * k));
+  dl_->PathStroke(col, 0, 3.4f * k * s_);
+}
+
+void Hub::XMark(float cx, float cy, float size, ImU32 col) {
+  const float k = size / 20 * 7;
+  dl_->AddLine(P(cx - k, cy - k), P(cx + k, cy + k), col, 3.4f * size / 20 * s_);
+  dl_->AddLine(P(cx - k, cy + k), P(cx + k, cy - k), col, 3.4f * size / 20 * s_);
+}
+
+// One of the setup's rows: what it is, the file, and how it checked out.
+void Hub::Row3(float y, const char* label, const std::string& name, int status, const std::string& note) {
+  const float x = kListX, w = kListW, h = 104;
+  Rect(x, y, w, h, White(0.07f), 12);
+  if (status == kRowBad) dl_->AddRectFilled(P(x, y), P(x + 5, y + h), kAccent, 12 * s_, ImDrawFlags_RoundCornersLeft);
+  Text(a_.body_bold, 15, x + 30, y + 20, White(0.45f), label, 0, 3);
+  const float note_w = note.empty() ? 0 : TextWidth(a_.body_bold, 21, note) + 56;
+  Text(a_.body_bold, 25, x + 30, y + 48, name.empty() ? White(0.4f) : White(0.94f),
+       Fit(a_.body_bold, 25, name.empty() ? "Not found" : name, w - 60 - std::max(note_w, 80.0f)));
+  const float cy = y + h * 0.5f + 2, icon_x = x + w - 44;
+  switch (status) {
+    case kRowChecking: Spinner(icon_x, cy, 13, White(0.8f)); break;
+    case kRowOk: Tick(icon_x, cy, 24, kText); break;
+    case kRowBad: XMark(icon_x, cy, 22, kAccent); break;
+    default: break;
+  }
+  if (!note.empty())
+    TextMid(a_.body_bold, 21, icon_x - 32, cy, status == kRowBad ? kAccent : White(0.7f), note, 1);
+}
+
+void Hub::DrawInstaller() {
+  const install::Job::Status st = job_->Get();
+  // what changed since the last frame
+  if (st.phase != job_phase_) {
+    switch (st.phase) {
+      case Phase::kProblem:
+      case Phase::kFailed: Play(Sound::kError); break;
+      case Phase::kDone:
+        Play(Sound::kOn);
+        state_ = install::Look(paths_.app);
+        break;
+      default: break;
+    }
+    job_phase_ = st.phase;
+    panel_in_ = 0;
+    if (st.phase == Phase::kCancelled) {
+      // back to the setup, looked at again
+      job_ = std::make_unique<install::Job>(paths_.app, InstallRoot());
+      job_phase_ = Phase::kChecking;
+      shown_progress_ = 0;
+      Toast("Install stopped. Nothing was kept.");
+      return;
+    }
+  }
+  const install::Sources& found = job_->Found();
+  const uint64_t needed = install::SpaceNeeded(found.disc_bytes);
+
+  // ---- the setup: what's there, and whether it can install
+  if (st.phase == Phase::kChecking || st.phase == Phase::kReady || st.phase == Phase::kProblem) {
+    PageTitle("INSTALL GTA IV", "One time only. The game is copied off your Xbox 360 disc image and set up on the PS5.");
+    const bool checking = st.phase == Phase::kChecking;
+    const bool disc_bad = st.phase == Phase::kProblem && (found.disc.empty() || st.disc.empty());
+    float y = kListY + 14;
+    Row3(y, found.disc.empty() || found.disc.has_extension() ? "DISC IMAGE" : "GAME FOLDER",
+         found.disc.filename().string(), checking ? kRowChecking : disc_bad ? kRowBad : kRowOk,
+         checking ? "Checking" : disc_bad ? (found.disc.empty() ? "Missing" : "Can't use") : st.disc);
+    y += 122;
+    Row3(y, "TITLE UPDATE 8", found.update.filename().string(), found.update.empty() ? kRowBad : kRowOk,
+         found.update.empty() ? "Missing" : install::Bytes(found.update_bytes));
+    y += 122;
+    // (the free space, when it can be known: a PS5 title can't ask)
+    const bool room = !free_space_ || free_space_ >= needed;
+    Row3(y, "SPACE", "Needs about " + install::Bytes(needed) + " free",
+         !free_space_ ? kRowNone : room ? kRowOk : kRowBad, free_space_ ? install::Bytes(free_space_) + " free" : "");
+    Panel([&](float px, float py, float pw) {
+      if (checking) {
+        Text(a_.display, 44, px, py, kText, "Checking");
+        Wrapped(a_.body, 22, px, py + 72, pw, White(0.65f),
+                "Making sure the disc image is the USA disc of GTA IV. This takes a few seconds.");
+      } else if (st.phase == Phase::kReady) {
+        Text(a_.display, 44, px, py, kText, "Ready");
+        py += 72;
+        py += Wrapped(a_.body, 22, px, py, pw, White(0.65f),
+                      "Press Cross to install. It takes a while: keep the app open until it's done. Your disc image "
+                      "isn't changed.") + 30;
+        Text(a_.body_bold, 15, px, py, White(0.45f), "INSTALLS TO", 0, 3);
+        Text(a_.body_bold, 21, px, py + 30, White(0.8f), "/data/homebrew/PPSA94004/UserData");
+      } else {
+        Text(a_.display, 44, px, py, kText, "Can't install yet");
+        py += 72;
+        py += Wrapped(a_.body, 22, px, py, pw, White(0.72f), st.problem) + 30;
+        Text(a_.body_bold, 15, px, py, White(0.45f), "THE INSTALL FOLDER", 0, 3);
+        Text(a_.body_bold, 21, px, py + 30, White(0.8f), "/data/homebrew/PPSA94004/install/");
+      }
+    });
+    return;
+  }
+
+  // ---- installing, done, or stopped
+  if (st.phase == Phase::kFailed) {
+    PageTitle("THE INSTALL STOPPED", "What was copied has been removed, so nothing is left half done.");
+    const float x = kListX, y = kListY + 14, w = 1100;
+    const int lines = int(WrapLines(a_.body, 23, w - 60, st.problem).size());
+    const float h = 84 + lines * 23 * 1.4f;
+    Rect(x, y, w, h, White(0.07f), 12);
+    dl_->AddRectFilled(P(x, y), P(x + 5, y + h), kAccent, 12 * s_, ImDrawFlags_RoundCornersLeft);
+    Text(a_.body_bold, 15, x + 30, y + 22, White(0.45f), "WHAT HAPPENED", 0, 3);
+    Wrapped(a_.body, 23, x + 30, y + 56, w - 60, White(0.85f), st.problem);
+    Wrapped(a_.body, 21, x, y + h + 30, w, White(0.55f),
+            "Press Cross to try again. If it stops again, send the log from /data/homebrew/PPSA94004/logs.");
+    return;
+  }
+
+  const bool done = st.phase == Phase::kDone;
+  Ease(shown_progress_, done ? 1.0f : st.progress, 3.5f);
+  if (done && shown_progress_ > 0.98f) shown_progress_ = 1;
+  const float p = std::clamp(shown_progress_, 0.0f, 1.0f);
+  if (done) PageTitle("INSTALLED", "GTA IV is set up on your PS5. Press Cross to play.");
+  else PageTitle("INSTALLING", "Keep the app open until it's done. The PS5 won't go to sleep.");
+  // the percentage, big
+  char pct[8];
+  std::snprintf(pct, sizeof(pct), "%d%%", done ? 100 : std::min(99, int(p * 100 + 0.0001f)));
+  Text(a_.display, 150, 104, 300, kText, pct);
+  // the step
+  Text(a_.body_bold, 15, 112, 530, White(0.45f),
+       done ? "ALL DONE" : st.step >= 2 ? "STEP 2 OF 2" : "STEP 1 OF 2", 0, 3);
+  Text(a_.body_bold, 27, 112, 558, White(0.92f),
+       done ? "The game's files are in place" : st.step >= 2 ? "Unpacking the game's archives"
+                                                          : "Copying the game from your disc image");
+  // the bar
+  const float bx = 112, by = 640, bw = 1696, bh = 12;
+  Rect(bx, by, bw, bh, White(0.12f), bh * 0.5f);
+  const float fw = std::max(bh, bw * p);
+  Rect(bx, by, fw, bh, kAccent, bh * 0.5f);
+  if (!done) {  // a light running along the filled part
+    dl_->PushClipRect(P(bx, by), P(bx + fw, by + bh), true);
+    const float run = std::fmod(time_ * 520.0f, fw + 400.0f) - 200.0f;
+    dl_->AddRectFilledMultiColor(P(bx + run - 140, by), P(bx + run, by + bh), White(0), White(0.35f), White(0.35f),
+                                 White(0));
+    dl_->AddRectFilledMultiColor(P(bx + run, by), P(bx + run + 140, by + bh), White(0.35f), White(0), White(0),
+                                 White(0.35f));
+    dl_->PopClipRect();
+  }
+  // the numbers under it
+  std::string left = install::Bytes(st.written) + " written";
+  if (done) left = "Took " + Minutes(st.seconds > 0 ? st.seconds : 1);
+  Text(a_.body, 21, bx, by + 40, White(0.6f), left);
+  if (!done) {
+    std::string right;
+    if (st.rate > 0) right = Rate(st.rate);
+    if (st.eta >= 0) right += (right.empty() ? "" : "  \xC2\xB7  ") + std::string("About ") + Minutes(st.eta) + " left";
+    else if (st.seconds > 2) right += (right.empty() ? "" : "  \xC2\xB7  ") + std::string("Working out the time left");
+    Text(a_.body, 21, bx + bw, by + 40, White(0.6f), right, 1);
+  }
+}
+
+void Hub::InstallerHints(float r) {
+  switch (job_phase_) {
+    case Phase::kChecking: Hint(r, kCircle, "Back"); break;
+    case Phase::kReady:
+      r = Hint(r, kCircle, "Back");
+      r = Hint(r, kTriangle, "Look Again");
+      Hint(r, kCross, "Install");
+      break;
+    case Phase::kProblem:
+      r = Hint(r, kCircle, "Back");
+      Hint(r, kTriangle, "Look Again");
+      break;
+    case Phase::kInstalling: Hint(r, kCircle, "Cancel"); break;
+    case Phase::kDone:
+      r = Hint(r, kCircle, "Home");
+      Hint(r, kCross, "Start Game");
+      break;
+    case Phase::kFailed:
+    case Phase::kCancelled:
+      r = Hint(r, kCircle, "Back");
+      Hint(r, kCross, "Try Again");
+      break;
+  }
+}
+
+// ---------------------------------------------------------------- controls
+
+void Hub::InstallerInput(uint32_t p) {
+  auto again = [this] {
+    job_ = std::make_unique<install::Job>(paths_.app, InstallRoot());
+    job_phase_ = Phase::kChecking;
+    free_space_ = install::FreeSpace(InstallRoot());
+    shown_progress_ = 0;
+    panel_in_ = 0;
+    Play(Sound::kSelect);
+  };
+  switch (job_phase_) {
+    case Phase::kChecking:
+      if (p & kCircle) Play(Sound::kBack), CloseInstaller();
+      break;
+    case Phase::kReady:
+      if (p & kCross) {
+        job_->Start();
+        press_ = 1;
+        Play(Sound::kStart);
+      } else if (p & kTriangle) {
+        again();
+      } else if (p & kCircle) {
+        Play(Sound::kBack), CloseInstaller();
+      }
+      break;
+    case Phase::kProblem:
+      if (p & (kTriangle | kCross)) again();
+      else if (p & kCircle) Play(Sound::kBack), CloseInstaller();
+      break;
+    case Phase::kInstalling:
+      if (p & kCircle) {
+        Play(Sound::kSelect);
+        Confirm("Stop installing?", "What's been copied so far is removed. You can start over later.", "Stop",
+                [this] {
+                  if (job_) job_->Cancel();
+                },
+                "Keep Going", nullptr);
+      }
+      break;
+    case Phase::kDone:
+      if (p & kCross) {
+        press_ = 1, launch_ = true;  // (Draw fades out and starts the game)
+      } else if (p & kCircle) {
+        Play(Sound::kBack), CloseInstaller();
+      }
+      break;
+    case Phase::kFailed:
+    case Phase::kCancelled:
+      if (p & kCross) again();
+      else if (p & kCircle) Play(Sound::kBack), CloseInstaller();
+      break;
+  }
+}
+
+}  // namespace gta4ps5::hub
